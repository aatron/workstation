// Waybar config — symlinked to ~/.config/waybar/config.jsonc by install.sh.
// Text only (no icon fonts), so nothing depends on a Nerd Font.
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["custom/claude", "custom/cursor", "pulseaudio", "network", "cpu", "memory", "tray", "custom/power"],
  "custom/claude": {
    "exec": "$HOME/.local/bin/ai-usage claude",
    "return-type": "json",
    "interval": 120,
    "on-click": "xdg-open https://claude.ai/settings/usage"
  },
  "custom/cursor": {
    "exec": "$HOME/.local/bin/ai-usage cursor",
    "return-type": "json",
    "interval": 120,
    "on-click": "xdg-open https://cursor.com/dashboard"
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "$HOME/.local/bin/power-menu"
  },
  "custom/launcher": { "format": "Apps", "tooltip": false, "on-click": "fuzzel" },
  "hyprland/window": { "max-length": 60 },
  "clock": { "format": "{:%a %b %d  %H:%M}" },
  "cpu": { "format": "CPU {usage}%" },
  "memory": { "format": "MEM {percentage}%" },
  "pulseaudio": { "format": "VOL {volume}%", "format-muted": "MUTED", "on-click": "pavucontrol" },
  "network": {
    "format-wifi": "{essid}",
    "format-ethernet": "ETH",
    "format-disconnected": "offline",
    "on-click": "nm-connection-editor"
  },
  "tray": { "spacing": 8 }
}
