#!/usr/bin/env python3
"""Waybar custom module: plan usage for Claude Code and Cursor.

    ai-usage claude    5-hour and weekly Claude plan usage
    ai-usage cursor    Cursor included-usage for the current billing cycle

Prints Waybar JSON (text, tooltip, class). Reads the tokens the two apps
already keep (Claude Code's ~/.claude/.credentials.json, Cursor's state.vscdb);
never refreshes or writes them, so an expired Claude token just shows "?"
until Claude Code next runs. Responses are cached so Waybar's polling and
network blips stay cheap and quiet.
"""
import base64
import json
import os
import re
import sqlite3
import sys
import time
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "ai-usage"
CACHE_TTL = 120  # seconds
HOME = Path.home()
CLAUDE_CREDS = HOME / ".claude" / ".credentials.json"
CURSOR_DB = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "Cursor/User/globalStorage/state.vscdb"


def fetch(url, headers):
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.load(resp)


def cached(name, loader):
    """Return loader()'s result, cached for CACHE_TTL; fall back to a stale copy on failure."""
    path = CACHE_DIR / f"{name}.json"
    try:
        if time.time() - path.stat().st_mtime < CACHE_TTL:
            return json.loads(path.read_text())
    except (OSError, ValueError):
        pass
    try:
        data = loader()
    except Exception:
        try:
            return json.loads(path.read_text())
        except (OSError, ValueError):
            raise
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data))
    return data


def level(pct):
    return "critical" if pct >= 90 else "warning" if pct >= 70 else ""


def until(iso):
    """'2h 5m' / '3d 4h' until an ISO timestamp."""
    secs = int((datetime.fromisoformat(iso.replace("Z", "+00:00")) - datetime.now(timezone.utc)).total_seconds())
    if secs <= 0:
        return "now"
    d, rem = divmod(secs, 86400)
    h, rem = divmod(rem, 3600)
    m = rem // 60
    return f"{d}d {h}h" if d else f"{h}h {m}m" if h else f"{m}m"


def claude():
    oauth = json.loads(CLAUDE_CREDS.read_text())["claudeAiOauth"]
    if oauth["expiresAt"] / 1000 < time.time():
        raise RuntimeError("Claude token expired; start Claude Code to refresh it")
    data = cached("claude", lambda: fetch(
        "https://api.anthropic.com/api/oauth/usage",
        {"Authorization": f"Bearer {oauth['accessToken']}", "anthropic-beta": "oauth-2025-04-20"},
    ))
    session, week = data["five_hour"], data["seven_day"]
    sp, wp = round(session["utilization"]), round(week["utilization"])
    tip = [
        f"Claude ({oauth.get('subscriptionType', 'plan')})",
        f"5-hour: {sp}%  (resets in {until(session['resets_at'])})",
        f"Weekly: {wp}%  (resets in {until(week['resets_at'])})",
    ]
    for key, label in (("seven_day_sonnet", "Weekly Sonnet"), ("seven_day_opus", "Weekly Opus")):
        if data.get(key):
            tip.append(f"{label}: {round(data[key]['utilization'])}%")
    return {"text": f"CLAUDE 5h {sp}% wk {wp}%", "tooltip": "\n".join(tip), "class": level(max(sp, wp))}


def cursor_cookie():
    db = sqlite3.connect(f"file:{CURSOR_DB}?mode=ro", uri=True)
    try:
        row = db.execute("SELECT value FROM ItemTable WHERE key='cursorAuth/accessToken'").fetchone()
    finally:
        db.close()
    if not row:
        raise RuntimeError("not signed in to Cursor")
    jwt = row[0]
    payload = jwt.split(".")[1]
    sub = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))["sub"]
    return f"WorkosCursorSessionToken={sub.split('|')[-1]}%3A%3A{jwt}"


def display_percent(message, fallback):
    """Percent from Cursor's dashboard sentence ("You've used 1% of ..."), else the raw field."""
    m = re.search(r"(\d+(?:\.\d+)?)%", message or "")
    return round(float(m.group(1))) if m else round(fallback or 0)


def cursor():
    data = cached("cursor", lambda: fetch("https://cursor.com/api/usage-summary", {"Cookie": cursor_cookie()}))
    plan = data["individualUsage"]["plan"]
    auto = display_percent(data.get("autoModelSelectedDisplayMessage"), plan.get("autoPercentUsed"))
    other = display_percent(data.get("namedModelSelectedDisplayMessage"), plan.get("apiPercentUsed"))
    tip = [
        f"Cursor ({data.get('membershipType', 'plan')})",
        f"Cursor (Auto/Composer): {auto}%",
        f"Other models (API): {other}%",
        f"Included usage: ${plan['used'] / 100:.2f} of ${plan['limit'] / 100:.2f}",
        f"Cycle resets in {until(data['billingCycleEnd'])}",
    ]
    return {"text": f"CURSOR {auto}% other {other}%", "tooltip": "\n".join(tip), "class": level(max(auto, other))}


def main():
    which = sys.argv[1] if len(sys.argv) > 1 else ""
    modules = {"claude": (claude, "CLAUDE"), "cursor": (cursor, "CURSOR")}
    if which not in modules:
        sys.exit("usage: ai-usage claude|cursor")
    fn, label = modules[which]
    try:
        out = fn()
    except Exception as exc:
        out = {"text": f"{label} ?", "tooltip": f"{label.title()} usage unavailable: {exc}", "class": "unavailable"}
    print(json.dumps(out))


if __name__ == "__main__":
    main()
